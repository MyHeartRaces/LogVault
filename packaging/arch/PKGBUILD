# Maintainer: LogVault
pkgname=logvault
pkgver=0.6.0
pkgrel=1
pkgdesc="GUI downloader/exporter for Warcraft Logs reports"
arch=("any")
url="https://github.com/MyHeartRaces/LogVault"
license=("MIT")
depends=("python" "tk")
source=("LogVault-${pkgver}.tar.gz::https://github.com/MyHeartRaces/LogVault/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=("SKIP")

package() {
  cd "$srcdir/LogVault-${pkgver}"

  install -d "$pkgdir/usr/lib/logvault"
  cp -a assets src run_cli.py run_gui.py pyproject.toml README.md "$pkgdir/usr/lib/logvault/"

  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/logvault-gui" <<'EOF'
#!/bin/sh
exec python /usr/lib/logvault/run_gui.py "$@"
EOF
  cat > "$pkgdir/usr/bin/logvault" <<'EOF'
#!/bin/sh
exec python /usr/lib/logvault/run_cli.py "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/logvault-gui" "$pkgdir/usr/bin/logvault"

  install -Dm644 packaging/linux/logvault.desktop "$pkgdir/usr/share/applications/logvault.desktop"
  install -Dm644 assets/logvault.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/logvault.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
